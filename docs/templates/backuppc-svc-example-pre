#!/bin/bash
# =============================================================================
# /usr/local/sbin/backuppc-svc-example-pre
# =============================================================================
#
# Example pre-backup script demonstrating common.sh usage.
# This is a template - adapt for your specific service.
#
# Called by BackupPC as DumpPreUserCmd:
#   $Conf{DumpPreUserCmd} = '/usr/local/sbin/backuppc-svc-example-pre $host';
#
# Exit codes:
#   0  - Success
#   1  - General error
#   2  - Configuration/validation error
#   3  - Staging operation failed
#   4  - Container operation failed
#   5  - Timeout
#   10 - Lock acquisition failed
#
# =============================================================================

# Source shared library
source /usr/local/lib/backuppc/common.sh
enable_strict_traps

# -----------------------------------------------------------------------------
# Configuration
# -----------------------------------------------------------------------------
SERVICE="example"
CONTAINER="ct-${SERVICE}"
STAGING_ROOT="/srv/backuppc-staging"
STAGING_DIR="${STAGING_ROOT}/${SERVICE}"

# Paths to extract from container (relative to /, no leading slash)
EXTRACT_PATHS=(
    "etc/${SERVICE}"
    "var/lib/${SERVICE}/config"
)

# -----------------------------------------------------------------------------
# Service-specific cleanup
# -----------------------------------------------------------------------------
# Called automatically on exit (success or failure)
# Can check $FAILED to determine if rollback is needed

cleanup_service() {
    if [[ "$FAILED" -ne 0 ]]; then
        warn "Cleaning up after failure in phase: ${FAIL_PHASE:-unknown}"
        # Add rollback logic here if needed, e.g.:
        # - Re-enable services that were stopped
        # - Remove partial staging data
        # - Restore container state
    fi
}

# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------
main() {
    timer_start "total"
    PHASE="init"

    # Register cleanup early so it runs even on early failures
    register_cleanup "cleanup_service"

    # Validate environment
    PHASE="validation"
    require_command incus
    require_directory "$STAGING_ROOT"

    # Prevent concurrent runs
    PHASE="locking"
    acquire_lock "$SERVICE"

    # Verify container exists and is running
    PHASE="container_check"
    if ! container_exists "$CONTAINER"; then
        fail 4 "Container does not exist: $CONTAINER"
    fi

    if ! container_running "$CONTAINER"; then
        warn "Container not running: $CONTAINER - starting it"
        incus start "$CONTAINER"
        wait_container_ready "$CONTAINER" 60
    fi

    # Clean staging area
    PHASE="staging_cleanup"
    cleanup_staging "$STAGING_DIR"

    # Extract paths from container
    PHASE="extraction"
    for path in "${EXTRACT_PATHS[@]}"; do
        # Determine destination subdirectory (preserve structure)
        local dest_subdir
        dest_subdir=$(dirname "$path" | tr '/' '-')
        [[ "$dest_subdir" == "." ]] && dest_subdir=""

        local dest="${STAGING_DIR}/${dest_subdir}"
        ensure_staging_dir "$dest"

        timer_start "extract_${path}"
        extract_container_path "$CONTAINER" "$path" "$dest"
        timer_log "extract_${path}" "Extracted ${path}"
    done

    PHASE="complete"
    timer_log "total" "Pre-backup for ${SERVICE}"
    log "Staging directory ready: $STAGING_DIR"
}

# Run main function
main "$@"
