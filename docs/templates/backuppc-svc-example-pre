# -----------------------------------------------------------------------------
# Capture Systemd Units
# -----------------------------------------------------------------------------
capture_systemd_units() {
    PHASE="systemd_service_dump"
    log "Capturing systemd enabled services"

    if ! incus exec "$APP_CT" -- systemctl list-unit-files --state=enabled \
        > "${SYSTEMD_DIR}/systemd-enabled.txt" 2>/dev/null; then
        warn "Failed to capture systemd unit list"
        return 1
    fi

    local unit_count
    unit_count=$(grep -c "enabled" "${SYSTEMD_DIR}/systemd-enabled.txt" 2>/dev/null || echo "0")
    log_indent "Enabled units: ${unit_count}"
}

# -----------------------------------------------------------------------------
# Generate Backup Summary
# -----------------------------------------------------------------------------
# Produces human-readable summary for logs and diagnostics.
# CUSTOMIZATION: Add service-specific summary items.
generate_summary() {
    PHASE="summary"
    log "Generating backup summary"

    log "=== Backup Summary ==="
    log "Staging directory: ${STAGING_DIR}"
    log "View directory:    ${VIEW_DIR}"
    log "Container:         ${APP_CT}"

    # CUSTOMIZATION: Add database info if applicable
    # log "Database:          ${DB_NAME}@${DB_HOST}"

    # CUSTOMIZATION: Add database dump size
    # if [[ -f "${DB_DIR}/mariadb.sql.zst" ]]; then
    #     log_indent "mariadb.sql.zst: $(du -h "${DB_DIR}/mariadb.sql.zst" | cut -f1)"
    # fi

    # Config directory stats
    if [[ -d "$CONFIG_DIR" ]]; then
        local file_list=""
        local file_count=0
        local restricted_dirs=""
        local restricted_dir_count=0

        file_list=$(find "$CONFIG_DIR" -type f 2>/dev/null || true)
        restricted_dirs=$(find "$CONFIG_DIR" -type d ! -readable 2>/dev/null || true)

        if [[ -n "$file_list" ]]; then
            file_count=$(wc -l <<< "$file_list")
        fi
        if [[ -n "$restricted_dirs" ]]; then
            restricted_dir_count=$(wc -l <<< "$restricted_dirs")
        fi

        if [[ $restricted_dir_count -gt 0 ]]; then
            log_indent "Config files: ${file_count}+ (${restricted_dir_count} restricted dirs)"
        else
            log_indent "Config files: ${file_count}"
        fi
    fi

    # CUSTOMIZATION: Add app-specific stats
    # if [[ -f "${APP_LIST_DIR}/plugins.txt" ]]; then
    #     local plugin_count
    #     plugin_count=$(wc -l < "${APP_LIST_DIR}/plugins.txt" 2>/dev/null || echo "0")
    #     log_indent "Plugins: ${plugin_count}"
    # fi

    # Package list stats
    if [[ -f "${PACKAGE_DIR}/pkglist-repo.txt" ]]; then
        local pkg_count
        pkg_count=$(wc -l < "${PACKAGE_DIR}/pkglist-repo.txt" 2>/dev/null || echo "0")
        log_indent "Installed packages: ${pkg_count}"
    fi

    # Systemd unit stats
    if [[ -f "${SYSTEMD_DIR}/systemd-enabled.txt" ]]; then
        local service_count timer_count
        service_count=$(grep -c '\.service' "${SYSTEMD_DIR}/systemd-enabled.txt" 2>/dev/null || echo "0")
        timer_count=$(grep -c '\.timer' "${SYSTEMD_DIR}/systemd-enabled.txt" 2>/dev/null || echo "0")
        log_indent "Enabled services: ${service_count}"
        log_indent "Enabled timers:   ${timer_count}" "    "
    fi
}

