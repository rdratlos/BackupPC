    # Required commands (host)
    require_command incus
    require_command sha256sum
    # CUSTOMIZATION: Add service-specific requirements
    # require_command mariadb-admin
    # require_command mariadb-dump
    # require_command zstd

    # Container validation
    require_running_container "$APP_CT"

    # Container commands
    # CUSTOMIZATION: Add commands your service needs
    require_container_command "$APP_CT" systemctl
    # require_container_command "$APP_CT" pacman      # For Arch/Manjaro
    # require_container_command "$APP_CT" <app-cli>   # e.g., occ for Nextcloud

    # CUSTOMIZATION: Database connectivity check (if applicable)
    # check_database

    # -------------------------------------------------------------------------
    # Phase: Staging Preparation
    # -------------------------------------------------------------------------
    PHASE="prepare"
    prepare_staging
    record_metadata

    # -------------------------------------------------------------------------
    # Phase: Bind Mount Setup
    # -------------------------------------------------------------------------
    PHASE="bind_mount_prepare"
    ensure_bind_mount "$STAGING_ROOT" "$VIEW_ROOT"

    # -------------------------------------------------------------------------
    # Phase: Service Quiescence (if applicable)
    # -------------------------------------------------------------------------
    # CUSTOMIZATION: Enable maintenance mode, stop services, etc.
    # PHASE="maintenance_on"
    # enable_maintenance_mode

    # -------------------------------------------------------------------------
    # Phase: Database Dump (if applicable)
    # -------------------------------------------------------------------------
    # CUSTOMIZATION: Dump database if service has one
    # dump_database

    # -------------------------------------------------------------------------
    # Phase: Configuration Extraction
    # -------------------------------------------------------------------------
    extract_config

    # -------------------------------------------------------------------------
    # Phase: Application State Capture (if applicable)
    # -------------------------------------------------------------------------
    # CUSTOMIZATION: Capture application-specific state
    # capture_app_status
    # capture_app_list

    # -------------------------------------------------------------------------
    # Phase: Package List Capture
    # -------------------------------------------------------------------------
    PHASE="package_list_dump"
    capture_container_package_lists "$APP_CT" "$PACKAGE_DIR"

    # -------------------------------------------------------------------------
    # Phase: Systemd Unit Capture
    # -------------------------------------------------------------------------
    capture_systemd_units

    # -------------------------------------------------------------------------
    # Phase: Summary
    # -------------------------------------------------------------------------
    generate_summary

    timer_log "total" "Pre-backup completed"

    # Exit handled by on_exit trap (which runs registered cleanup actions)
}

main "$@"
