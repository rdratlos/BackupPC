#!/usr/bin/env bash
# =============================================================================
# /usr/local/sbin/backuppc-svc-<SERVICE>-post
# =============================================================================
#
# Post hook for BackupPC *service backups* of the <SERVICE> service.
# Validates backup artifacts, records status, and manages cleanup.
#
# -----------------------------------------------------------------------------
# TEMPLATE CUSTOMIZATION GUIDE
# -----------------------------------------------------------------------------
# This is a template for creating service-specific post-backup scripts.
# Search for "<" to find all customization points.
#
# Required customizations:
#   1. SERVICE          - Service identifier (must match pre-backup)
#   2. APP_CT           - Container name (if cleanup requires container access)
#   3. STAGING_DIR      - Must match pre-backup script paths
#   4. Critical artifacts - Files that MUST pass validation
#   5. app_cleanup()    - Service-specific cleanup (e.g., disable maintenance)
#
# Key responsibilities:
#   - Validate backup transfer succeeded (via xferOK from BackupPC)
#   - Verify artifact integrity (zstd, checksums)
#   - Run application cleanup (restore service operation)
#   - Record completion status in meta directory
#   - Clean up bind mount and staging on success
#   - Preserve staging on failure for investigation
#
# Reference implementations:
#   - backuppc-svc-mariadb-post   (database service with binlog validation)
#   - backuppc-svc-nextcloud-post (web app with maintenance mode cleanup)
#
# -----------------------------------------------------------------------------
#
# Responsibilities:
#   • <DESCRIBE SERVICE CLEANUP - e.g., "Restore service operation (disable
#     maintenance mode)">
#   • Validate staged artifacts (DB dump, config snapshot)
#   • Record meta information (status, error, timestamps, xferOK)
#   • On success: unmount BackupPC view and remove staging
#   • On failure or xferOK!=1: keep bind mount + staging as evidence
#
# Command contract (BackupPC):
#   DumpPostUserCmd should invoke this script with:
#     backuppc-svc-<SERVICE>-post <cmdType> <xferOK>
#   where:
#     cmdType : BackupPC command type (string)
#     xferOK  : 1=transfer ok, 0=transfer failed (may be empty in some paths)
#
# Key paths:
#   • Staging (scratch): <STAGING_DIR>
#   • BackupPC view:     <VIEW_DIR>
#
# Artifact validation (in priority order):
#   CRITICAL (failure if invalid):
#     • <artifact-path>            - <Description>
#
#   IMPORTANT (warning if invalid):
#     • <optional-artifact>        - <Description>
#
#   ADVISORY (presence check only):
#     • config/                    - Application configuration
#     • meta/                      - Backup metadata
#     • package-list/              - Container package lists
#     • systemd-list/              - Enabled services
#
# Preconditions:
#   • The user "backuppc" must be allowed to bind mount and unmount
#     the service staging directory.
#
#   • Sudoers rules must be in place (see doc/setup):
#       backuppc ALL = NOPASSWD: /usr/bin/mount --bind <STAGING_ROOT> <VIEW_ROOT>
#       backuppc ALL = NOPASSWD: /usr/bin/umount <VIEW_DIR>
#       backuppc ALL = NOPASSWD: /usr/local/sbin/backuppc-staging-cleanup
#
# Exit codes:
#   0   - Success
#   1   - General error
#   2   - Configuration/validation error
#   3   - Staging operation failed
#   4   - Container operation failed
#   5   - Timeout
#   10  - Lock acquisition failed
#   100 - BackupPC transfer failed (xferOK=0)
#
# =============================================================================

# Source shared library
source /usr/local/lib/backuppc/common.sh

# Enable strict error handling
enable_strict_traps

# =============================================================================
# CONFIGURATION
# =============================================================================
# CUSTOMIZATION: These MUST match your pre-backup script paths exactly.

# Service identification
# CUSTOMIZATION REQUIRED: Set service name and container
readonly SERVICE="<service>"
readonly APP_CT="<container-name>"

# Paths
# CUSTOMIZATION REQUIRED: Must match pre-backup script
readonly STAGING_ROOT="/export/mariadb/backuppc/services"
readonly VIEW_ROOT="/srv/backuppc/services"

readonly STAGING_DIR="${STAGING_ROOT}/${SERVICE}"
readonly VIEW_DIR="${VIEW_ROOT}/${SERVICE}"

readonly META_DIR="${STAGING_DIR}/meta"

# Artifact paths
# CUSTOMIZATION: Define paths to your backup artifacts
readonly DB_DIR="${STAGING_DIR}/db"
readonly CONFIG_DIR="${STAGING_DIR}/config"

# Critical artifacts (must pass validation)
# CUSTOMIZATION REQUIRED: Path to your critical artifact(s)
readonly CRITICAL_DUMP="${DB_DIR}/<dump-file>.sql.zst"

# =============================================================================
# POST-SCRIPT EXIT HANDLER
# =============================================================================
# Custom exit handler that:
#   1. Writes meta information (always)
#   2. Runs application cleanup (always - e.g., disable maintenance mode)
#   3. Writes final status based on FAILED and xferOK
#   4. Finalizes mount and staging (cleanup on success, preserve on failure)

post_exit_handler() {
    local rc=$?

    # Disable ERR trap during cleanup
    trap - ERR

    # If we're exiting due to a failure, use the captured code
    local final_rc="$rc"
    if [[ "$FAILED" -ne 0 ]]; then
        final_rc="$FAIL_RC"
    fi

    # Always write meta information
    write_meta_xferok "$META_DIR"

    # Run application cleanup (e.g., disable maintenance mode)
    # CUSTOMIZATION: Remove this call if your service has no cleanup
    app_cleanup

    # Write final status
    if [[ "$FAILED" -ne 0 ]]; then
        write_meta_status "$META_DIR" "failed" "${FAIL_MSG:-unknown error}"
        error "POST backup failed: ${FAIL_MSG:-unknown error}"
    elif [[ "$XFER_OK" -ne 1 ]]; then
        write_meta_status "$META_DIR" "failed" "xferOK=${XFER_OK}: BackupPC transfer failed"
        error "BackupPC transfer failed (xferOK=${XFER_OK})"
        FAILED=1
        final_rc=100
    else
        write_meta_status "$META_DIR" "ok"
        log "All checks OK and BackupPC transfer OK (xferOK=1)"
    fi

    # Finalize mount and staging based on success/failure
    finalize_mount_and_staging

    # Final log message
    if [[ "$FAILED" -ne 0 ]]; then
        error "==== ${SCRIPT_NAME} FAILED ===="
    else
        log "==== ${SCRIPT_NAME} completed successfully ===="
    fi

    exit "$final_rc"
}

